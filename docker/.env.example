# ==============================================================================
# NUXIVA ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copia questo file come riferimento per configurare le variabili d'ambiente
# in Portainer (sezione "Environment variables" dello stack Git).
#
# ⚠️ NON COMMITTARE CREDENZIALI REALI NEL REPOSITORY GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# NETWORK & PORTS (Architettura Originale)
# ------------------------------------------------------------------------------
# Porta pubblica mappata su host (internamente container usa porta 80)
# Kiosk display pubblico, chat interattiva e wizard di installazione
NUXIVA_PUBLIC_PORT=8444

# Porta admin mappata su host (internamente container usa porta 8080)
# Cockpit amministrativo (autenticazione PAM), REST API e server MCP
NUXIVA_ADMIN_PORT=8445

# Nota: Porta 8443 (core backend) e 11434 (Ollama) sono solo localhost

# ------------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider LLM: "openai" per endpoint OpenAI-compatible, "ollama" per Ollama nativo
LLM_PROVIDER=openai

# OpenAI-Compatible Endpoint (es. OmniRoute, LiteLLM, vLLM, OpenRouter)
# Per OmniRoute: http://10.0.0.105:20128/v1
OPENAI_BASE_URL=http://10.0.0.105:20128/v1

# API Key per autenticazione endpoint OpenAI-compatible
# ⚠️ OBBLIGATORIO per OmniRoute e altri gateway con autenticazione
OPENAI_API_KEY=sk-your-omniroute-key-here

# Modello di default per gli agenti (opzionale)
# Esempi: "Combinazione-Auto", "zoo-orchestrator", "antigravity/gemini-3-flash"
DEFAULT_LLM_MODEL=

# Ollama Endpoint (usato solo se LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# EMBEDDING CONFIGURATION
# ------------------------------------------------------------------------------
# Il motore di embedding supporta automaticamente:
# 1. Endpoint OpenAI-compatible /v1/embeddings (se OPENAI_BASE_URL è configurato)
# 2. Ollama /api/embeddings (fallback)
# 3. FastEmbed locale CPU-only (fallback finale)
#
# Non serve configurazione aggiuntiva: il sistema seleziona automaticamente
# il provider disponibile.

# ------------------------------------------------------------------------------
# HOME ASSISTANT INTEGRATION (opzionale)
# ------------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=

# ------------------------------------------------------------------------------
# FRIGATE INTEGRATION (opzionale)
# ------------------------------------------------------------------------------
FRIGATE_URL=http://127.0.0.1:5000
